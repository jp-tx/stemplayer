<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>0.4.6</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" Exclude="Assets\py\**" />
    <EmbeddedResource Include="Assets\py\runner.py" LogicalName="runner.py" />
    <EmbeddedResource Include="Assets\py\beat_detect.py" LogicalName="beat_detect.py" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio.Core" Version="3.1.0" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <!--
    Silk.NET's native loader only probes next to the executable (and a couple of other real paths);
    it does not know how to find a library extracted from inside a PublishSingleFile bundle. Keep
    the OpenAL Soft native library as a loose file alongside the single-file exe on every platform
    so OpenAL playback actually works (confirmed broken on Windows before this fix).
  -->
  <Target Name="KeepOpenAlSoftLoose" AfterTargets="ComputeResolvedFilesToPublishList" BeforeTargets="GenerateSingleFileBundle">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.FileName)%(ResolvedFileToPublish.Extension)' == 'soft_oal.dll'
                  OR '%(ResolvedFileToPublish.FileName)%(ResolvedFileToPublish.Extension)' == 'libopenal.so'
                  OR '%(ResolvedFileToPublish.FileName)%(ResolvedFileToPublish.Extension)' == 'libopenal.dylib'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
