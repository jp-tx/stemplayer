<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StemPlayer.Views.ReuseStemsWindow"
        Title="Already split before" Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="16">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="OnCancel" />
      <Button Content="Re-split" Click="OnResplit" />
      <Button Content="Reuse existing stems" Click="OnReuse" Classes="accent" />
    </StackPanel>
  </StackPanel>
</Window>
