<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StemPlayer.ViewModels"
        xmlns:models="using:StemPlayer.Models"
        x:Class="StemPlayer.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Options" Width="640" Height="680" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="Save" Click="OnSave" Classes="accent" />
      <Button Content="Cancel" Click="OnCancel" />
    </StackPanel>
    <ScrollViewer>
      <StackPanel Spacing="14">
        <StackPanel Spacing="6">
          <TextBlock Text="Separation algorithm" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" HorizontalAlignment="Stretch" />
          <TextBlock Text="{Binding PresetDescription}" Opacity="0.7" TextWrapping="Wrap" />
          <TextBlock Text="Model file name (editable, any model audio-separator supports)" Opacity="0.7" />
          <TextBox Text="{Binding Model}" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Processor" FontWeight="SemiBold" />
          <RadioButton GroupName="dev" IsChecked="{Binding UseGpu}" Content="GPU (NVIDIA CUDA, AMD/Intel via DirectML on Windows or ROCm on Linux, Apple Silicon)" />
          <RadioButton GroupName="dev" IsChecked="{Binding UseCpu}" Content="CPU (works everywhere, slower)" />
          <TextBlock TextWrapping="Wrap" Opacity="0.7"
                     Text="GPU mode uses whatever accelerator the installed Python packages support and falls back to CPU if none is found. Use 'Detect' below to see what is available." />
          <Button Content="Detect accelerators" Command="{Binding DetectGpuCommand}" IsEnabled="{Binding !Busy}" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Python environment" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" Opacity="0.7"
                     Text="StemPlayer keeps audio-separator and yt-dlp (YouTube import) in its own virtual environment. Requires Python 3.10+ and ffmpeg on PATH." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}" MinWidth="160" />
            <Button Content="Set up Python environment" Command="{Binding InstallCommand}" IsEnabled="{Binding !Busy}" />
          </StackPanel>
          <TextBlock Text="Custom Python executable (optional, leave empty to use the managed environment)" Opacity="0.7" />
          <TextBox Text="{Binding PythonPath}" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Library folder (blank = ~/Music/StemPlayer)" FontWeight="SemiBold" />
          <TextBox Text="{Binding LibraryDir}" />
        </StackPanel>

        <Border BorderThickness="1" BorderBrush="Gray" CornerRadius="4" Height="180" Padding="6">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Output}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontFamily="monospace" FontSize="11" TextWrapping="Wrap" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
